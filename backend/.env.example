# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding (local = 离线可用; openai = 兼容 OpenAI 的向量服务) ----
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=512

# ---- Database (留空 = SQLite data/database.db) ----
# PostgreSQL 示例: postgresql+asyncpg://user:pass@localhost:5432/ai_world
DATABASE_URL=

# ---- Security ----
JWT_SECRET=please-change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Uploads ----
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx
MAX_UPLOAD_MB=20

# ---- Demo account ----
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
