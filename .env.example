# ============================================================
# AI World 环境变量（复制为 .env 后按需修改）
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库
# ============================================================

# ---- DeepSeek 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=90
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# ---- 向量化 ----
# local  : 内置离线哈希向量（零依赖，开箱即用）
# openai : 任意兼容 OpenAI /embeddings 的服务（如 BGE-M3）
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=512

# ---- RAG ----
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHARS=6000

# ---- 数据库（留空 = SQLite: data/database.db）----
DATABASE_URL=
SQL_ECHO=false

# ---- 安全 ----
# 生产环境务必改成足够随机的长字符串
JWT_SECRET=please-change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 上传限制 ----
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx
MAX_UPLOAD_MB=20

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 演示账号 ----
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
