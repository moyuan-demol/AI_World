# ============================================================
# AI World 环境变量（复制为 .env 后按需修改）
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库
# ============================================================

# ---- DeepSeek 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
# 可选：deepseek-v4-flash（默认，快而便宜）/ deepseek-v4-pro / deepseek-v4-flash-vision-exp
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=90
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# ---- 上下文与记忆（关键：限制单次请求的上下文规模）----
HISTORY_LIMIT=12          # 每次带多少条历史消息
HISTORY_CHAR_BUDGET=6000  # 历史消息总字符预算，超出则丢弃最旧的
MEMORY_INJECT_LIMIT=5     # 注入多少条长期记忆

# ---- 长记忆三件套 ----
SUMMARY_ENABLED=true             # 滚动摘要：滑出窗口的旧消息压缩成摘要
HISTORY_RETRIEVAL_ENABLED=true   # 历史向量检索：按相关度召回窗口外的历史
HISTORY_RETRIEVAL_TOP_K=3
HISTORY_RETRIEVAL_SCAN=200
MEMORY_AUTO_EXTRACT=true         # 自动事实抽取（需要可用的模型 Key）
MEMORY_EXTRACT_EVERY=6           # 每 N 条消息触发一次抽取

# ---- 多 Agent RAG（拆解 / 查找 / 审查 / 整理）----
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_ROUNDS=2         # 审查-补检的最大轮次（有界，防费用失控）
MULTI_AGENT_TOP_K=4              # 每个子问题检索多少条证据

# ---- 数据库自动备份（本地文件复制，零成本）----
BACKUP_ENABLED=true
BACKUP_KEEP=5                    # 保留最近几份
BACKUP_DIR=                      # 留空 = data/backups

# ---- 向量化 ----
# local  : 内置离线哈希向量（零依赖，开箱即用）
# openai : 任意兼容 OpenAI /embeddings 的服务（如 BGE-M3）
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=512

# ---- RAG ----
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHARS=6000

# ---- 数据库（留空 = SQLite: data/database.db）----
DATABASE_URL=
SQL_ECHO=false

# ---- 安全 ----
# 生产环境务必改成足够随机的长字符串
JWT_SECRET=please-change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 上传限制 ----
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx
MAX_UPLOAD_MB=20

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 演示账号 ----
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# ---- 权限（Phase 2）：逗号分隔的管理员用户名 ----
# 留空 = 没有管理员；把用户名写进来即可启用 /api/admin/* 接口
ADMIN_USERNAMES=
